# Server-side only. Never expose these to the browser.
PRIMAL_ENROLLMENT_KEY=replace-with-a-long-random-value
PRIMAL_ADMIN_KEY=replace-with-a-different-long-random-value
PRIMAL_OFFLINE_SECONDS=90
# Optional. Neon/Postgres is preferred over Blob for concurrent writes.
DATABASE_URL=
# Set automatically when the Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=
